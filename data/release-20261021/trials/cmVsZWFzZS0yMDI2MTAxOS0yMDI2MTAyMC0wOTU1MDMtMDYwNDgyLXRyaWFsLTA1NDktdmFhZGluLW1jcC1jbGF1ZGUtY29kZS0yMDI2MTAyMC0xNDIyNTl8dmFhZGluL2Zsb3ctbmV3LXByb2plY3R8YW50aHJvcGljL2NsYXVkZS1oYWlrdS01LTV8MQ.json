.H1;\n+import com.vaadin.flow.component.html.ListItem;\n+import com.vaadin.flow.component.html.Span;\n+import com.vaadin.flow.component.html.UnorderedList;\n+import com.vaadin.flow.component.orderedlayout.HorizontalLayout;\n+import com.vaadin.flow.component.orderedlayout.VerticalLayout;\n+import com.vaadin.flow.component.textfield.TextField;\n+import com.vaadin.flow.router.Route;\n+\n+@Route(value = \"\", layout = MainLayout.class)\n+public class ItemsView extends VerticalLayout {\n+\n+    private final List<String> items = new ArrayList<>();\n+\n+    private final TextField itemField = new TextField(\"Item\");\n+    private final UnorderedList itemList = new UnorderedList();\n+    private final Span count = new Span();\n+\n+    public ItemsView() {\n+        Button addButton = new Button(\"Add\", e -> addItem());\n+        Button clearButton = new Button(\"Clear\", e -> clearItems());\n+\n+        HorizontalLayout entry = new HorizontalLayout(itemField, addButton, clearButton);\n+\n+        add(new H1(\"Items\"), entry, itemList, count);\n+        updateCount();\n+    }\n+\n+    private void addItem() {\n+        String value = itemField.getValue();\n+        if (value == null || value.isBlank()) {\n+            itemField.setInvalid(true);\n+            itemField.setErrorMessage(\"Enter an item\");\n+            return;\n+        }\n+        items.add(value);\n+        itemList.add(new ListItem(value));\n+        itemField.clear();\n+        itemField.setInvalid(false);\n+        updateCount();\n+    }\n+\n+    private void clearItems() {\n+        items.clear();\n+        itemList.removeAll();\n+        updateCount();\n+    }\n+\n+    private void updateCount() {\n+        count.setText(\"Items: \" + items.size());\n+    }\n+\n+}\ndiff --git a/src/main/java/com/example/MainLayout.java b/src/main/java/com/example/MainLayout.java\nnew file mode 100644\nindex 0000000..071eeda\n--- /dev/null\n+++ b/src/main/java/com/example/MainLayout.java\n@@ -0,0 +1,12 @@\n+package 